{
  "addr": "127.0.0.1:8787",
  "publicURL": "http://publish.devcloud.woa.com",
  "maxUpload": "8GiB",
  "maxFiles": 10000,
  "partSize": "8MiB",
  "minPartSize": "1MiB",
  "maxPartSize": "64MiB",
  "maxPartConcurrency": 16,
  "uploadTTL": "24h",
  "stateDir": "/data/relkit-agent",
  "productRootParent": "/data/relkit",
  "rootKeyId": "",
  "custodyManifest": "",
  "publish": {
    "publishTo": ["serve"],
    "backends": {
      "serve": {
        "type": "relkit-compatible",
        "baseUrl": "https://update-internal.devcloud.woa.com/",
        "uploadUrl": "https://publish.devcloud.woa.com/",
        "tokenEnv": "RELKIT_SERVE_TOKEN",
        "timeoutSeconds": 600
      }
    },
    "directory": {"publishTo": ["serve"]}
  }
}
