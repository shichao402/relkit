[Unit]
Description=relkit publish agent
After=network.target

[Service]
Type=simple
User=relkit
Group=relkit
WorkingDirectory=/srv/relkit
ExecStart=/usr/local/bin/relkit-agent -config /etc/relkit-agent/relkit-agent.json
Restart=on-failure
RestartSec=3
EnvironmentFile=-/etc/relkit-agent/env
# COS credentials live in EnvironmentFile, never in the unit.
# Signing keys are PER PRODUCT: <product-root>/.relkit-keys/, referenced by
# signing.privateKeyPath. Never set a global signing key here.

[Install]
WantedBy=multi-user.target
