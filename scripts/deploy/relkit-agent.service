[Unit]
Description=relkit publish agent
After=network.target

[Service]
Type=simple
User=relkit
Group=relkit
WorkingDirectory=/srv/relkit
ExecStart=/usr/local/bin/relkit-agent -config /etc/relkit-agent/relkit-agent.json
Restart=on-failure
RestartSec=3
EnvironmentFile=-/etc/relkit-agent/env
# COS credentials live in EnvironmentFile, never in the unit.
# Signing is ONE root per server, named by rootKeyId and resolved through the
# custody manifest (requirements 10.1, 10.5). There is no per-product signing
# key any more, and the unit never mentions a key path.

[Install]
WantedBy=multi-user.target
