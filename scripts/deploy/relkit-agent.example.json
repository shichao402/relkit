{
  "addr": "127.0.0.1:8787",
  "publicURL": "https://publish.firoyang.com",
  "maxUpload": "8GiB",
  "maxFiles": 10000,
  "partSize": "8MiB",
  "minPartSize": "1MiB",
  "maxPartSize": "64MiB",
  "maxPartConcurrency": 16,
  "uploadTTL": "24h",
  "stateDir": "/var/lib/relkit-agent",
  "productRootParent": "",
  "rootKeyId": "",
  "custodyManifest": "",
  "publish": {
    "publishTo": ["serve"],
    "backends": {
      "serve": {
        "type": "relkit-compatible",
        "baseUrl": "https://update-internal.firoyang.com/",
        "uploadUrl": "https://publish.firoyang.com/",
        "tokenEnv": "RELKIT_SERVE_TOKEN",
        "timeoutSeconds": 600
      }
    },
    "directory": {"publishTo": ["serve"]}
  },
  "site": {
    "sinks": [
      {"type": "backend", "backend": "serve"},
      {"type": "directory", "path": "/srv/relkit/site"}
    ]
  }
}
