{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relkit.dev/schemas/relkit.extension/1",
  "title": "relkit.extension/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "command", "stdinSchema", "stdoutSchema"],
  "properties": {
    "schema": { "const": "relkit.extension/1" },
    "kind": {
      "type": "string",
      "enum": [
        "artifact-producer",
        "version-provider",
        "mirror-producer",
        "bundle-producer",
        "ci-adapter",
        "deploy-adapter",
        "rotate-adapter"
      ]
    },
    "command": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "stdinSchema": { "type": "string" },
    "stdoutSchema": { "type": "string" },
    "timeoutSeconds": { "type": "integer", "minimum": 1 },
    "workingDirectory": { "type": "string" },
    "envAllowlist": {
      "type": "array",
      "items": { "type": "string" }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["read-workspace", "write-out-dir", "network-declared", "exec-self"]
      }
    }
  },
  "description": "Extensions must not create or modify resolution, staged docs, index, or signatures."
}
