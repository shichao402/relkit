{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relkit.dev/schemas/relkit.operator-profile/1",
  "title": "relkit.operator-profile/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "deploymentId",
    "serverRelease",
    "selectionPolicy",
    "provides",
    "sequence",
    "signatures"
  ],
  "properties": {
    "schema": { "const": "relkit.operator-profile/1" },
    "deploymentId": { "type": "string", "minLength": 1 },
    "serverRelease": {
      "type": "object",
      "required": ["version", "commit", "distributionDigest"],
      "properties": {
        "version": { "type": "string" },
        "commit": { "type": "string" },
        "distributionDigest": { "type": "string" }
      }
    },
    "selectionPolicy": {
      "type": "string",
      "enum": ["exact", "latest-compatible"]
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "peer"],
        "properties": {
          "domain": {
            "type": "string",
            "enum": ["rupSchemaSet", "publishProtocol", "updaterIpc", "artifactSet"]
          },
          "peer": { "type": "string", "minLength": 1 },
          "id": { "type": "string" },
          "min": { "type": "integer" },
          "max": { "type": "integer" }
        }
      }
    },
    "publishTransaction": { "type": "array", "items": { "type": "string" } },
    "endpoints": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "backends": { "type": "array", "items": { "type": "string" } },
    "serviceIdentity": { "type": "string" },
    "secretRefs": {
      "type": "object",
      "description": "Named references only; never plaintext secrets"
    },
    "sources": {
      "type": "object",
      "properties": {
        "mirrors": { "type": "array", "items": { "type": "string" } },
        "bundles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "inventoryRef": { "type": "string" },
    "ciAdapterRef": { "type": "string" },
    "sequence": { "type": "integer", "minimum": 1 },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "algorithm", "value"],
        "properties": {
          "keyId": { "type": "string", "minLength": 1 },
          "algorithm": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    }
  }
}
