{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relkit.dev/schemas/relkit.runtime-profile/1",
  "title": "relkit.runtime-profile/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "product",
    "profileVersion",
    "allowedChannels",
    "directoryBootstrap",
    "rupSchemaSet",
    "digest",
    "signatures"
  ],
  "properties": {
    "schema": { "const": "relkit.runtime-profile/1" },
    "product": { "type": "string" },
    "profileVersion": { "type": "integer", "minimum": 1 },
    "allowedChannels": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "directoryBootstrap": {
      "type": "object",
      "required": ["entryUrls"],
      "properties": {
        "entryUrls": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "recovery": { "type": "object" }
      }
    },
    "rupSchemaSet": { "type": "string" },
    "digest": { "type": "string" },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "algorithm", "value"],
        "properties": {
          "keyId": {
            "type": "string",
            "description": "Must resolve through the subscriber's external Product RUP Root; profile must not self-certify"
          },
          "algorithm": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    }
  }
}
