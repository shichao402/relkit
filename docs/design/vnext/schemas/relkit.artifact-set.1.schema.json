{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relkit.dev/schemas/relkit.artifact-set/1",
  "title": "relkit.artifact-set/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "resolutionDigest", "product", "version", "channel", "artifacts"],
  "properties": {
    "schema": { "const": "relkit.artifact-set/1" },
    "resolutionDigest": { "type": "string" },
    "product": { "type": "string" },
    "version": { "type": "string" },
    "channel": { "type": "string" },
    "changelog": { "type": "string" },
    "display": { "type": "object" },
    "mergeIdentity": {
      "type": "object",
      "description": "Shared identity for multi-platform drop merge",
      "properties": {
        "product": { "type": "string" },
        "version": { "type": "string" },
        "channel": { "type": "string" },
        "resolutionDigest": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "kind", "sha256", "size"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["installer", "payload", "blob", "metadata", "other"]
          },
          "platform": { "type": "string" },
          "selectors": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "sha256": { "type": "string" },
          "size": { "type": "integer", "minimum": 0 },
          "relations": {
            "type": "object",
            "properties": {
              "installOf": { "type": "string" },
              "payloadOf": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
