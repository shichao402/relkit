{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relkit.dev/schemas/relkit.runtime-bootstrap/1",
  "title": "relkit.runtime-bootstrap/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "resolutionDigest",
    "profileDigest",
    "rootFingerprint",
    "profile",
    "trustedKeys"
  ],
  "properties": {
    "schema": { "const": "relkit.runtime-bootstrap/1" },
    "resolutionDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "profileDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "rootFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "profile": {
      "$ref": "https://relkit.dev/schemas/relkit.runtime-profile/1"
    },
    "trustedKeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "key"],
        "properties": {
          "keyId": { "type": "string", "minLength": 1 },
          "key": {
            "type": "string",
            "contentEncoding": "base64",
            "description": "Externally trusted raw ed25519 public key selected by rootFingerprint"
          }
        }
      }
    }
  }
}
