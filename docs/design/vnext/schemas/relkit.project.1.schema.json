{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relkit.dev/schemas/relkit.project/1",
  "title": "relkit.project/1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "capability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "peer", "id"],
          "properties": {
            "domain": { "enum": ["rupSchemaSet", "artifactSet"] },
            "peer": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "peer", "min", "max"],
          "properties": {
            "domain": { "enum": ["publishProtocol", "updaterIpc"] },
            "peer": { "type": "string", "minLength": 1 },
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    }
  },
  "required": ["schema", "product", "operatorRef", "trustFingerprint", "roles", "capabilityFingerprint"],
  "properties": {
    "schema": { "const": "relkit.project/1" },
    "product": { "type": "string", "minLength": 1 },
    "channels": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "versionPolicy": { "type": "object" },
    "selectorDimensions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "operatorRef": { "type": "string", "minLength": 1 },
    "trustFingerprint": {
      "type": "string",
      "description": "Distribution Root fingerprint; not a product RUP key"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["publisher", "updater-host", "subscriber", "updater-projection"]
      }
    },
    "artifactProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "extensionSchema": { "const": "relkit.extension/1" },
        "timeoutSeconds": { "type": "integer", "minimum": 0 },
        "envAllowlist": { "type": "array", "items": { "type": "string" } },
        "permissions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "versionProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "extensionSchema": { "const": "relkit.extension/1" },
        "timeoutSeconds": { "type": "integer", "minimum": 0 },
        "envAllowlist": { "type": "array", "items": { "type": "string" } },
        "permissions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "runtimeProfileSubscriptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productRef", "rootFingerprint"],
        "properties": {
          "productRef": { "type": "string" },
          "rootFingerprint": { "type": "string" }
        }
      }
    },
    "runtimeProfilePublication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootFingerprint", "rupSchemaSet"],
      "properties": {
        "rootFingerprint": { "type": "string" },
        "rupSchemaSet": { "type": "string" },
        "recovery": { "type": "object" }
      }
    },
    "capabilityFingerprint": {
      "type": "object",
      "required": ["osArch", "facades", "projections", "topology", "subscriptions", "requiredContracts"],
      "properties": {
        "osArch": { "type": "array", "items": { "type": "string" } },
        "facades": { "type": "array", "items": { "type": "string" } },
        "projections": { "type": "array", "items": { "type": "string" } },
        "topology": { "type": "string" },
        "subscriptions": { "type": "array", "items": { "type": "string" } },
        "requiredContracts": {
          "type": "array",
          "items": { "$ref": "#/$defs/capability" }
        }
      }
    }
  },
  "not": {
    "anyOf": [
      { "required": ["release"] },
      { "required": ["relkitVersion"] },
      { "required": ["token"] },
      { "required": ["ssh"] },
      { "required": ["uploadUrl"] }
    ]
  }
}
