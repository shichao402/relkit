{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relkit.dev/schemas/relkit.resolution/1",
  "title": "relkit.resolution/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "identity",
    "authorityFingerprint",
    "projectDigest",
    "operator",
    "catalogSnapshotDigest",
    "selectedDistribution",
    "components",
    "contracts",
    "digest"
  ],
  "properties": {
    "schema": { "const": "relkit.resolution/1" },
    "identity": {
      "type": "string",
      "enum": ["production", "candidate"]
    },
    "authorityFingerprint": { "type": "string" },
    "allowedChannels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "projectDigest": { "type": "string" },
    "operator": {
      "type": "object",
      "required": ["deploymentId", "profileDigest", "sequence", "selectionPolicy"],
      "properties": {
        "deploymentId": { "type": "string" },
        "profileDigest": { "type": "string" },
        "sequence": { "type": "integer" },
        "selectionPolicy": {
          "type": "string",
          "enum": ["exact", "latest-compatible"]
        }
      }
    },
    "catalogSnapshotDigest": { "type": "string" },
    "runtimeProfileDigests": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "selectedDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit", "digest"],
      "properties": {
        "version": { "type": "string" },
        "commit": { "type": "string" },
        "digest": { "type": "string" },
        "modulePath": { "type": "string" },
        "moduleH1": { "type": "string" },
        "releaseAssets": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "platform", "sha256", "source"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "platform": { "type": "string" },
          "sha256": { "type": "string" },
          "source": {
            "type": "string",
            "enum": ["module", "release-asset", "bundle", "mirror"]
          },
          "locator": { "type": "string" },
          "mirrors": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "peer"],
        "properties": {
          "domain": {
            "type": "string",
            "enum": ["rupSchemaSet", "publishProtocol", "updaterIpc", "artifactSet"]
          },
          "peer": { "type": "string", "minLength": 1 },
          "id": { "type": "string" },
          "min": { "type": "integer" },
          "max": { "type": "integer" }
        }
      }
    },
    "digest": {
      "type": "string",
      "description": "Canonical JSON digest of this resolution excluding the digest field itself"
    }
  },
  "if": {
    "properties": { "identity": { "const": "candidate" } }
  },
  "then": {
    "properties": {
      "allowedChannels": {
        "type": "array",
        "items": { "not": { "const": "stable" } }
      }
    }
  }
}
