{
  "addr": ":8080",
  "dir": "/srv/releases",
  "uploadTokenFile": "/etc/relkit-serve/relkit-serve.token",
  "maxUpload": "4GiB",
  "cache": {
    "noCache": ["index/", "fallback/", "directory/"],
    "immutable": ["manifest/", "artifact/"],
    "defaultMaxAge": 60
  },
  "gc": {
    "enabled": true,
    "interval": "1h"
  },
  "shutdownTimeout": "30s",
  "logRequests": true
}
