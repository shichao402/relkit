    },
    {
      "name": "reject-source-build-lock",
      "description": "A lock with any other schema is refused: source builds are unsupported consumption.",
      "lock": { "schema": "relkit.consume/1", "release": "v0.1.0", "commit": "aaaa" },
      "expectParse": null
    },
    {
      "name": "reject-v3-without-source",
      "description": "consume/3 without a source block is refused; the module channel is not optional.",
