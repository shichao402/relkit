{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.invalid/rup/1/manifest.schema.json",
  "title": "RUP Release Manifest v1",
  "description": "某一个版本的产物清单。不可变文档，一个版本一份。禁止单独签名——其完整性由 index 中记录的 manifest.sha256 加上 index 自身的签名传递而来。",
  "type": "object",
  "required": ["schema", "product", "version", "code", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "rup.manifest/1"
    },
    "product": {
      "$ref": "#/$defs/identifier",
      "description": "必须与 index 的 product 一致，客户端必须校验"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "必须与对应 index 节点的 version 一致，客户端必须校验"
    },
    "code": {
      "type": "integer",
      "minimum": 0,
      "description": "必须与对应 index 节点的 code 一致，客户端必须校验"
    },
    "releasedAt": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "maxLength": 8192
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "artifact": {
      "type": "object",
      "required": ["id", "filename", "size", "sha256", "kind", "selectors", "urls"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier",
          "description": "同一 manifest 内唯一。稳定标识，供宿主按 id 直接取件；也是多个 selectors 同时匹配时的仲裁依据（取字典序最小）"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/\\\\\u0000-\u001F]+$",
          "not": { "enum": [".", ".."] },
          "description": "建议的落盘文件名。禁止包含路径分隔符与控制字符。客户端落盘前仍必须按 SPEC.md §14.4 复校，包括 Windows 保留设备名"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "type": "string",
          "enum": ["archive", "installer", "binary", "blob"],
          "description": "给宿主的处理提示。宿主遇到无法识别的取值应该跳过该 artifact 而非报错，以便协议将来扩展"
        },
        "selectors": {
          "type": "object",
          "description": "客户端匹配条件。空对象表示适用于所有客户端。标准键：os / arch / target / abi / variant，也允许自定义键",
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        },
        "meta": {
          "type": "object",
          "description": "宿主自定义的透传数据，协议禁止解释其内容。凡是只有单个项目关心的信息都放这里，不要为其增加顶层字段"
        }
      }
    }
  }
}
