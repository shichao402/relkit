{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.invalid/rup/1/staged.schema.json",
  "title": "RUP Staged Release v1",
  "description": "发布流程第一阶段的产出：已固化但尚未上网的版本描述，只存在于本地。定义性特征是禁止包含任何 urls、后端名称、tag、bucket、域名等与托管位置相关的信息——这保证了第一阶段可完全离线、可重复、可单测，且同一份 staged 可以发布到任意多个后端而无需重新计算哈希。",
  "type": "object",
  "required": ["schema", "product", "version", "code", "channel", "createdAt", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "rup.staged/1"
    },
    "product": { "$ref": "#/$defs/identifier" },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "code": {
      "type": "integer",
      "minimum": 0
    },
    "minFrom": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "channel": { "$ref": "#/$defs/identifier" },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "maxLength": 8192
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stagedArtifact" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "stagedArtifact": {
      "type": "object",
      "required": ["id", "filename", "size", "sha256", "kind", "selectors"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/\\\\\u0000-\u001F]+$",
          "not": { "enum": [".", ".."] }
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "type": "string",
          "enum": ["archive", "installer", "binary", "blob"]
        },
        "selectors": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "meta": {
          "type": "object"
        },
        "sourcePath": {
          "type": "string",
          "description": "唯一的本地专有字段，仅供人工排查。发布时必须丢弃，禁止出现在 manifest 中"
        }
      }
    }
  }
}
