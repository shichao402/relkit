.relkit/cache/
.relkit/onboarding.json
.relkit/drop-incoming/
/dist/
/dist-tools/
/scripts/deploy/.venv/
tmp/
*.exe
*.private.json
coverage.out

# The console front end's build output is committed on purpose: `go build` on a
# Go-only checkout must work, since cmd/relkit-console/internal/webui embeds it.
!cmd/relkit-console/internal/webui/dist/
!cmd/relkit-console/internal/webui/dist/**

# Front-end dependencies are restored with npm ci.
cmd/relkit-console/web/node_modules/

# TypeScript incremental build caches (`tsc -b` writes these next to the configs).
*.tsbuildinfo

__pycache__/
*.pyc

# one-shot / debug scripts
scripts/temp/*
!scripts/temp/.gitkeep

# local HTML preview output (`go run ./internal/browse/preview`)
preview-out/
internal/browse/preview/out/
**/templates/out/


# Local secrets (Dec / Bitwarden landing path; do not commit)
/relkit.secrets.json

# Dec managed paths (never commit)
.dec/cache/
.dec/sync/
.dec/.version
/.secrets/

bindings/ts/node_modules/
.with/
