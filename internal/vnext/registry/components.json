{
  "schema": "relkit.component-registry/1",
  "buildTargets": ["linux-amd64", "linux-arm64", "windows-amd64", "darwin-amd64", "darwin-arm64"],
  "components": [
    {
      "name": "store",
      "role": "infrastructure-binary",
      "transport": "release-asset",
      "targets": ["linux-amd64", "linux-arm64"],
      "build": {
        "flag": "store",
        "goPackage": "./cmd/relkit-store",
        "binaryPrefix": "relkit-store"
      }
    },
    {
      "name": "console",
      "role": "infrastructure-binary",
      "transport": "release-asset",
      "targets": ["linux-amd64", "linux-arm64"],
      "build": {
        "flag": "console",
        "goPackage": "./cmd/relkit-console",
        "binaryPrefix": "relkit-console"
      }
    },
    {
      "name": "agent",
      "role": "infrastructure-binary",
      "transport": "release-asset",
      "targets": ["linux-amd64", "linux-arm64"],
      "build": {
        "flag": "agent",
        "goPackage": "./cmd/relkit-agent",
        "binaryPrefix": "relkit-agent"
      }
    },
    {
      "name": "ops",
      "role": "infrastructure-binary",
      "transport": "release-asset",
      "targets": ["linux-amd64", "linux-arm64", "windows-amd64", "darwin-amd64", "darwin-arm64", "darwin-universal"],
      "build": {
        "flag": "ops",
        "goPackage": "./cmd/relkit-ops",
        "binaryPrefix": "relkit-ops"
      }
    },
    {
      "name": "cli",
      "role": "product-binary",
      "transport": "release-asset",
      "targets": ["linux-amd64", "linux-arm64", "windows-amd64", "darwin-amd64", "darwin-arm64", "darwin-universal"],
      "destination": ".relkit/components/bin",
      "default": true,
      "build": {
        "flag": "cli",
        "goPackage": "./cmd/relkit",
        "binaryPrefix": "relkit"
      }
    },
    {
      "name": "updater",
      "role": "product-binary",
      "transport": "release-asset",
      "targets": ["linux-amd64", "linux-arm64", "windows-amd64", "darwin-amd64", "darwin-arm64", "darwin-universal"],
      "destination": ".relkit/components/bin",
      "default": true,
      "build": {
        "flag": "updater",
        "goPackage": "./cmd/relkit-updater",
        "binaryPrefix": "relkit-updater"
      }
    },
    {
      "name": "sdk-dart",
      "role": "facade",
      "transport": "release-asset",
      "targets": ["all"],
      "destination": ".relkit/components/sdk/dart",
      "build": {
        "flag": "dart-sdk",
        "archive": "relkit-sdk-dart.zip",
        "source": "sdk/dart",
        "updaterProcess": "dart",
        "facadePaths": ["lib/src/updater_facade.dart"],
        "pack": {
          "kind": "tracked-tree",
          "excludePaths": ["lib/src/updater.dart", "lib/src/scheduler.dart", "example/", "test/"]
        }
      }
    },
    {
      "name": "sdk-rust",
      "role": "facade",
      "transport": "release-asset",
      "targets": ["all"],
      "destination": ".relkit/components/sdk/rust",
      "build": {
        "flag": "rust-sdk",
        "archive": "relkit-sdk-rust.zip",
        "source": "sdk/rust",
        "updaterProcess": "rust",
        "facadePaths": ["src/lib.rs"],
        "pack": {
          "kind": "tracked-tree",
          "extras": [["proto/updater/v1/updater.proto", "proto/updater/v1/updater.proto"]]
        }
      }
    },
    {
      "name": "bindings-ts",
      "role": "projection",
      "transport": "release-asset",
      "targets": ["all"],
      "destination": ".relkit/components/bindings/ts",
      "build": {
        "flag": "bindings-ts",
        "archive": "relkit-bindings-ts.zip",
        "source": "bindings/ts",
        "updaterProcess": "node",
        "facadePaths": ["dist/updater_pb.js"],
        "pack": {
          "kind": "listed-files",
          "files": ["package.json", "README.md", "dist/updater_pb.js", "dist/updater_pb.d.ts"]
        }
      }
    }
  ]
}
