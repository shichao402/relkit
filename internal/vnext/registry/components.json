{
  "schema": "relkit.component-registry/1",
  "buildTargets": ["linux-amd64", "linux-arm64", "windows-amd64", "darwin-amd64", "darwin-arm64"],
  "components": [
    {
      "name": "store",
      "role": "infrastructure-binary",
      "transport": "release-asset",
      "targets": ["linux-amd64", "linux-arm64"],
      "build": {
        "flag": "store",
        "goPackage": "./cmd/relkit-store",
        "binaryPrefix": "relkit-store"
      }
    },
    {
      "name": "console",
      "role": "infrastructure-binary",
      "transport": "release-asset",
      "targets": ["linux-amd64", "linux-arm64"],
      "build": {
        "flag": "console",
        "goPackage": "./cmd/relkit-console",
        "binaryPrefix": "relkit-console"
      }
    },
    {
      "name": "agent",
      "role": "infrastructure-binary",
      "transport": "release-asset",
      "targets": ["linux-amd64", "linux-arm64"],
      "build": {
        "flag": "agent",
        "goPackage": "./cmd/relkit-agent",
        "binaryPrefix": "relkit-agent"
      }
    },
    {
      "name": "ops",
      "role": "infrastructure-binary",
      "transport": "release-asset",
      "targets": ["linux-amd64", "linux-arm64", "windows-amd64", "darwin-amd64", "darwin-arm64", "darwin-universal"],
      "build": {
        "flag": "ops",
        "goPackage": "./cmd/relkit-ops",
        "binaryPrefix": "relkit-ops"
      }
    },
    {
      "name": "cli",
      "role": "product-binary",
      "transport": "release-asset",
      "targets": ["linux-amd64", "linux-arm64", "windows-amd64", "darwin-amd64", "darwin-arm64", "darwin-universal"],
      "destination": ".relkit/components/bin",
      "default": true,
      "build": {
        "flag": "cli",
        "goPackage": "./cmd/relkit",
        "binaryPrefix": "relkit"
      }
    },
    {
      "name": "updater",
      "role": "product-binary",
      "transport": "release-asset",
      "targets": ["linux-amd64", "linux-arm64", "windows-amd64", "darwin-amd64", "darwin-arm64", "darwin-universal"],
      "destination": ".relkit/components/bin",
      "default": true,
      "build": {
        "flag": "updater",
        "goPackage": "./cmd/relkit-updater",
        "binaryPrefix": "relkit-updater"
      }
    }
  ]
}
